QMainWindow, QWidget {
    background-color: #0D0F14;
    color: #E8EAED;
}

QFrame#sidebar {
    background-color: #0A0C10;
    border-right: 1px solid #1E2330;
}

QPushButton#nav_btn {
    background-color: transparent;
    color: #8A94A6;
    border: none;
    padding: 10px;
    text-align: left;
}

QPushButton#nav_btn:hover {
    background-color: #151820;
    color: #E8EAED;
}

QPushButton#nav_btn:checked {
    background-color: rgba(0, 212, 255, 0.1);
    color: #00D4FF;
    border-left: 3px solid #00D4FF;
}

QFrame[class="stat-card"] {
    background-color: #151820;
    border: 1px solid #1E2330;
    border-radius: 8px;
    padding: 16px;
}

QTableView {
    background-color: #151820;
    alternate-background-color: #1A1F2E;
    gridline-color: #1E2330;
    selection-background-color: #2A3045;
    selection-color: #E8EAED;
    border: 1px solid #1E2330;
}

QHeaderView::section {
    background-color: #0A0C10;
    color: #8A94A6;
    padding: 4px;
    border: 1px solid #1E2330;
}

QPushButton.btn_primary {
    background-color: #3B82F6;
    color: #E8EAED;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton.btn_success {
    background-color: #00E676;
    color: #0D0F14;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton.btn_danger {
    background-color: #FF3D5A;
    color: #E8EAED;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton.btn_secondary {
    background-color: transparent;
    color: #8A94A6;
    border: 1px solid #2A3045;
    border-radius: 4px;
    padding: 6px 12px;
}

QLineEdit, QTextEdit, QComboBox {
    background-color: #151820;
    border: 1px solid #2A3045;
    color: #E8EAED;
    padding: 4px;
    border-radius: 4px;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #00D4FF;
}

QDialog {
    background-color: #0D0F14;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #0D0F14;
    width: 6px;
    height: 6px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #2A3045;
    border-radius: 3px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

QProgressBar {
    background-color: #1E2330;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #00D4FF, stop:1 #3B82F6);
    border-radius: 4px;
}

QLabel.badge_critical {
    background-color: #FF3D5A;
    color: #E8EAED;
    padding: 2px 6px;
    border-radius: 4px;
}

QLabel.badge_high {
    background-color: #FF8C42;
    color: #E8EAED;
    padding: 2px 6px;
    border-radius: 4px;
}

QLabel.badge_medium {
    background-color: #FFD700;
    color: #0D0F14;
    padding: 2px 6px;
    border-radius: 4px;
}

QLabel.badge_low {
    background-color: #00C9A7;
    color: #0D0F14;
    padding: 2px 6px;
    border-radius: 4px;
}

QLabel.badge_info {
    background-color: #00D4FF;
    color: #0D0F14;
    padding: 2px 6px;
    border-radius: 4px;
}

QTabWidget::pane {
    border: 1px solid #1E2330;
    background-color: #0D0F14;
}

QTabBar::tab {
    background-color: #0A0C10;
    color: #8A94A6;
    padding: 8px 16px;
    border: none;
}

QTabBar::tab:selected {
    color: #00D4FF;
    border-bottom: 2px solid #00D4FF;
}

QGroupBox {
    border: 1px solid #1E2330;
    border-radius: 6px;
    margin-top: 12px;
}

QGroupBox::title {
    color: #8A94A6;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    left: 8px;
}

QToolTip {
    background-color: #1E2330;
    color: #E8EAED;
    border: 1px solid #2A3045;
    padding: 4px;
}

QStatusBar {
    background-color: #0A0C10;
    border-top: 1px solid #1E2330;
    color: #8A94A6;
}
