/* =========================================================
   Security Management Platform - Ollama Minimalist Theme
   Version: V9.1
   ========================================================= */

/* ── Root & Globals ── */
QMainWindow, QWidget, QDialog {
    background-color: #000000; /* Pure black */
    color: #FFFFFF; /* Pure white text */
    font-family: -apple-system, "SF Pro Text", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    border: none;
    outline: none;
}

/* ── Sidebar ── */
QFrame#sidebar {
    background-color: #000000;
    border-right: 1px solid #333333;
}

QLabel#brand_label {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    padding: 0px 20px;
}

QLabel#brand_sub {
    color: #888888;
    font-size: 11px;
    letter-spacing: 1px;
    padding: 0px 20px 16px 20px;
    text-transform: uppercase;
}

QPushButton#nav_btn {
    background-color: transparent;
    color: #AAAAAA;
    border: none;
    border-radius: 4px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    margin: 2px 12px;
}
QPushButton#nav_btn:hover {
    background-color: #1A1A1A;
    color: #FFFFFF;
}
QPushButton#nav_btn[active="true"] {
    background-color: #FFFFFF;
    color: #000000;
    font-weight: 600;
}

/* ── Content Area ── */
QFrame#content_area {
    background-color: #000000;
}

/* ── Typography ── */
QLabel#page_title {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -1px;
    padding: 4px 0px;
}
QLabel#page_subtitle {
    color: #888888;
    font-size: 14px;
    padding: 0px 0px 16px 0px;
}

/* ── Cards & Containers ── */
QFrame#card, QFrame#kpi_card {
    background-color: #0A0A0A;
    border: 1px solid #333333;
    border-radius: 6px;
}
QFrame#card:hover, QFrame#kpi_card:hover {
    border: 1px solid #555555;
}
QFrame#card_highlight {
    background-color: #0A0A0A;
    border: 1px solid #FFFFFF;
    border-radius: 6px;
}

/* ── Group Boxes ── */
QGroupBox {
    background-color: #000000;
    border: 1px solid #333333;
    border-radius: 6px;
    margin-top: 24px;
    padding: 24px 16px 16px 16px;
    font-size: 14px;
    color: #DDDDDD;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 10px;
    padding: 0 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
}

/* ── Buttons ── */
QPushButton {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #333333;
    border-color: #555555;
}
QPushButton:pressed {
    background-color: #000000;
}
QPushButton:disabled {
    background-color: #0A0A0A;
    color: #555555;
    border-color: #222222;
}

/* Specialized Buttons */
QPushButton#btn_primary {
    background-color: #FFFFFF;
    color: #000000;
    border: none;
    font-weight: 600;
}
QPushButton#btn_primary:hover {
    background-color: #E0E0E0;
}
QPushButton#btn_secondary {
    background-color: transparent;
    color: #CCCCCC;
    border: 1px solid #555555;
}
QPushButton#btn_secondary:hover {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border-color: #888888;
}

/* ── Inputs ── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0A0A0A;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 10px 14px;
    color: #FFFFFF;
    font-size: 14px;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}
QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #888888;
}

/* ── ComboBox ── */
QComboBox {
    background-color: #0A0A0A;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 10px 14px;
    color: #FFFFFF;
    font-size: 14px;
}
QComboBox:focus {
    border: 1px solid #888888;
}

/* ── Tables ── */
QTableWidget {
    background-color: #000000;
    border: 1px solid #333333;
    border-radius: 6px;
    gridline-color: #222222;
    selection-background-color: #1A1A1A;
    selection-color: #FFFFFF;
    alternate-background-color: #0A0A0A;
    font-size: 14px;
    color: #CCCCCC;
}
QTableWidget::item {
    padding: 8px 12px;
    border: none;
}
QHeaderView::section {
    background-color: #000000;
    color: #888888;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #333333;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

/* ── Text Areas ── */
QTextEdit {
    background-color: #0A0A0A;
    border: 1px solid #333333;
    border-radius: 6px;
    font-family: "Menlo", "Monaco", "Courier New", monospace;
    font-size: 14px;
    color: #CCCCCC;
    padding: 16px;
}

/* ── Scroll Bars ── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #555555;
}

/* ── Labels ── */
QLabel#form_label {
    color: #888888;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

/* ── Status Badges ── */
QLabel#badge_green { color: #000000; background-color: #FFFFFF; border-radius: 4px; padding: 4px 8px; font-size: 11px; font-weight: 700; }
QLabel#badge_red { color: #FFFFFF; background-color: #333333; border-radius: 4px; padding: 4px 8px; font-size: 11px; font-weight: 700; }
QLabel#badge_orange { color: #FFFFFF; background-color: #222222; border-radius: 4px; padding: 4px 8px; font-size: 11px; font-weight: 700; }
QLabel#badge_blue { color: #000000; background-color: #DDDDDD; border-radius: 4px; padding: 4px 8px; font-size: 11px; font-weight: 700; }
QLabel#badge_gray { color: #AAAAAA; background-color: #1A1A1A; border-radius: 4px; padding: 4px 8px; font-size: 11px; font-weight: 700; }
