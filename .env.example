# Security Management Platform (SMP) — Environment Variables
#
# NOTE: SMP does NOT require any paid API keys. All dependencies are
# free and open-source. GreyNoise, NVD, and EPSS use their free-tier
# public APIs (no key required for basic rate limits).
#
# Copy this file to .env and fill in values as needed.
# SMP does NOT auto-load .env — set these in your shell or systemd unit.

# ── Authentication ──────────────────────────────────────────────────────────
# JWT secret for the REST API server (api/auth.py).
#
# REQUIRED in production.  SMP refuses to issue tokens when this variable is
# absent or shorter than 32 characters.  Generate a strong secret:
#
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Minimum length: 32 characters (256-bit equivalent).
# The value is NEVER written to logs at any level.
#
# Key rotation: change this value and restart the API server.  All existing
# tokens become invalid immediately (signed with the old key).  This key is
# INDEPENDENT of the password-hashing salt in config/auth.json — rotating
# the user password does NOT rotate the JWT key and vice-versa.
#
# Development / CI only: leave SMP_JWT_SECRET unset and additionally set
#   SMP_DEV_ALLOW_INSECURE_JWT=1
# to allow an ephemeral per-process key.  A WARNING is emitted at startup.
# NEVER set SMP_DEV_ALLOW_INSECURE_JWT=1 in production.
SMP_JWT_SECRET=

# ── Network / Egress ─────────────────────────────────────────────────────────
# Set to "1" to block all outbound intelligence API calls (NVD, EPSS, CISA,
# GreyNoise). Useful for air-gapped environments. (tools/egress_auditor.py)
SMP_LOCAL_ONLY=0

# ── CI Mode ──────────────────────────────────────────────────────────────────
# Set to "1" by the GitHub Actions CI workflow. Skips MAC randomisation,
# per-scanner delays, and tool self-heal installs during test runs.
# Do not set this in production. (scanners/scan_runner.py, scanners/core/dag.py)
SMP_CI=0

# Development escape hatch: allows api/auth.py to generate an ephemeral
# per-process JWT signing secret when SMP_JWT_SECRET is not set.
# NEVER set this to "1" in production.
SMP_DEV_ALLOW_INSECURE_JWT=0

# ── Proxy Configuration (Optional) ───────────────────────────────────────────
# If operating behind a corporate proxy, set these. Scanner subprocesses and
# Python HTTP clients respect them where applicable. (scanners/scan_runner.py)
HTTP_PROXY=http://127.0.0.1:8080
HTTPS_PROXY=http://127.0.0.1:8080
http_proxy=http://127.0.0.1:8080
https_proxy=http://127.0.0.1:8080
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# ── Qt / UI (Optional — Linux only) ──────────────────────────────────────────
# Workaround for Wayland sessions: force XCB (X11) backend. (main.py)
QT_QPA_PLATFORM=xcb
XDG_SESSION_TYPE=x11

# Suppress noisy Qt logging rules that clutter the terminal. (main.py)
# SMP sets this automatically at startup; listed here for completeness.
QT_LOGGING_RULES=qt.qpa.*=false;qt.xkb.compose=false
