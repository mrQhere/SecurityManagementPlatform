# Security Management Platform (SMP) - Environment Variables
# 
# NOTE: SMP does NOT require any paid API keys. This project is committed to
# free/open-source-only dependencies.

# Authentication
# Secret key used for signing JWT tokens in the REST API.
SMP_JWT_SECRET=your_super_secret_jwt_key_here

# Network / Egress
# Set to '1', 'true', or 'yes' to completely block outbound intelligence API calls.
SMP_LOCAL_ONLY=0

# Proxy Configuration (Optional)
# If you are operating behind a corporate proxy, set these variables.
# SMP tools and scanners will respect them where applicable.
HTTP_PROXY=http://127.0.0.1:8080
HTTPS_PROXY=http://127.0.0.1:8080
http_proxy=http://127.0.0.1:8080
https_proxy=http://127.0.0.1:8080
no_proxy=localhost,127.0.0.1,::1

# UI Configuration (Optional)
# Workaround for Wayland sessions on Linux.
QT_QPA_PLATFORM=xcb
XDG_SESSION_TYPE=x11
